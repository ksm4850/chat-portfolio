# 운영 compose 변수. 서버에서 deploy/.env 로 복사해 채운다. Git 에 올리지 않는다.
# 방문자 화면과 관리자 화면 호스트. Cloudflare DNS 에 두 레코드 모두 프록시로 둔다.
SITE_HOST=portfolio.sangmyeong.dev
ADMIN_HOST=admin.sangmyeong.dev
# openssl rand -hex 24
POSTGRES_PASSWORD=
# GA4 측정 ID(G-XXXX). 비우면 GA 를 붙이지 않는다.
VITE_GA_ID=
# 서버에서 저장소를 받은 사용자의 uid(id -u). 1000 이면 비워도 된다.
APP_UID=1000
