# 백엔드 설정 템플릿. 로컬은 `.env.local`, 서버는 `.env.prod` 로 복사해 채운다. 둘 다 Git에 올리지 않는다.
# 서버(.env.prod)에서 바꿀 값: ENVIRONMENT=prod, JWT_SECRET_KEY(openssl rand -hex 32), LLM_PROVIDER=openai,
#   OPENAI_API_KEY(배포 전용 프로젝트 키), DATABASE_POOL_SIZE=3·DATABASE_MAX_OVERFLOW=2(1GB 서버).
#   DATABASE_URL·REDIS_URL 은 운영 compose 가 넣으므로 무시된다.
ENVIRONMENT=local
LOG_LEVEL=INFO
# auto = local 이면 사람이 읽는 텍스트, 그 밖에는 JSON 한 줄
LOG_FORMAT=auto
API_PREFIX=/api

# PostgreSQL 비동기 접속 정보
DATABASE_URL=postgresql+asyncpg://app:changeme@localhost:5433/app
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT=5

# JWT. 운영에서는 반드시 새로 생성한 값을 쓴다 (openssl rand -hex 32)
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# 비어 있으면 CORS 를 켜지 않는다. 예: CORS_ORIGINS=["https://app.example.com"]
CORS_ORIGINS=[]

# 로그인 시도 제한 (window 초 안에 허용하는 횟수). 메모리 기반이라 프로세스마다 따로 센다.
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
LOGIN_RATE_LIMIT_PER_IP=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Redis. 세션별 최근 대화와 사용량 카운터
REDIS_URL=redis://localhost:6380/0

# LLM. claude_cli 는 개인 구독이라 local 에서만 쓸 수 있다. 배포는 openai.
LLM_PROVIDER=claude_cli
LLM_CLI_PATH=claude
LLM_MODEL=haiku
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=1000

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6.1-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG. 임베딩은 항상 OpenAI(OPENAI_API_KEY 필요). 모델을 바꾸면 reembed_knowledge 로 기존 기억을 다시 임베딩한다.
EMBEDDING_TIMEOUT_SECONDS=30
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=100
RAG_TOP_K=4

# 대화. 최근 N턴만 보관하고, 마지막 대화 뒤 TTL 이 지나면 세션이 사라진다.
CHAT_HISTORY_TURNS=10
CHAT_SESSION_TTL_SECONDS=86400

# 익명 방문자 토큰
VISITOR_TOKEN_EXPIRE_DAYS=30
VISITOR_TOKENS_PER_IP_PER_HOUR=10

# 사용량 제한. 테스트하며 조정한다.
CHAT_MESSAGE_MAX_LENGTH=500
CHAT_MIN_INTERVAL_SECONDS=2
CHAT_MESSAGES_PER_SESSION=20
CHAT_MESSAGES_PER_VISITOR_PER_DAY=50
CHAT_MESSAGES_PER_IP_PER_HOUR=60
CHAT_LLM_CALLS_PER_DAY=500

# 포트폴리오 안내(AG-UI). 점수는 코사인 유사도(OpenAI 임베딩 기준).
GUIDE_CHARACTER_SLUG=me
GUIDE_LLM_ENABLED=true
GUIDE_SEARCH_LIMIT=6
GUIDE_SOURCE_MIN_SCORE=0.30
GUIDE_ACTION_MIN_SCORE=0.45
# 대화 맥락: 최근 MAX_TURNS 턴 보관, 그중 최근 TURNS 턴은 질문·답변, 나머지는 질문만. 답변은 MAX_CHARS 에서 자른다.
GUIDE_HISTORY_TURNS=3
GUIDE_HISTORY_MAX_TURNS=8
GUIDE_HISTORY_ANSWER_MAX_CHARS=400

# STT. Deepgram 실시간 인식. https://console.deepgram.com 에서 키를 발급한다.
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=ko

# LLM 추적(Langfuse). 비워 두면 보내지 않는다. 호스트는 콘솔의 리전 주소.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
